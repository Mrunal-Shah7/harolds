# SPRINT-1: example environment file — every variable documented; real .env is gitignored
#
# Copy to `.env` at the repository root and fill in real values:
#   cp .env.example .env

# ── Required (Sprint 1) ──────────────────────────────────────────────────────

# PostgreSQL connection URL for the application role.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local example — replace USER/PASSWORD with your Windows PostgreSQL credentials.
# The role needs CREATEDB (or an explicit shadow DB URL) for `pnpm db:migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harolds?schema=public"

# Runtime environment. Allowed: development | test | production
NODE_ENV="development"

# Public base URL of the application (used in links, CORS, Absolute URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── NMI payments (required from Sprint 17) ───────────────────────────────────

# Active gateway: sandbox | production. Selects WHICH key triple below is used, and
# which NMI host is called (sandbox.nmi.com vs secure.nmi.com — they are not
# interchangeable; a sandbox account is rejected by the production host).
# Glance check: logged at API startup and exposed on GET /api/v1/health.
NMI_ENVIRONMENT="sandbox"

# Sandbox credentials. Required when NMI_ENVIRONMENT=sandbox; may be blank otherwise.
# Security key: server-side only, never exposed to the browser.
NMI_SECURITY_KEY_SANDBOX=""
# Tokenization key: public, used by Collect.js in the browser.
NMI_TOKENIZATION_KEY_SANDBOX=""
# Webhook signing key: verifies the HMAC on inbound webhook calls.
NMI_WEBHOOK_SIGNING_KEY_SANDBOX=""

# Live credentials. Required when NMI_ENVIRONMENT=production; may be blank otherwise.
# Only the ACTIVE triple is validated, so you do not need to invent live keys to run sandbox.
NMI_SECURITY_KEY_LIVE=""
NMI_TOKENIZATION_KEY_LIVE=""
NMI_WEBHOOK_SIGNING_KEY_LIVE=""

# ── Storefront (browser-exposed) — required for NMI Collect.js ───────────────
# The tokenization key above is not secret (only the security key is). Collect.js runs
# in the browser and needs its own NEXT_PUBLIC_ copy, inlined at BUILD time, to tokenise
# cards client-side. A runtime-only value produces a bundle that renders
# "Payments are not configured yet" forever — so the build fails when this is absent.
# Keep these equal to NMI_TOKENIZATION_KEY_<ACTIVE> / NMI_ENVIRONMENT above.
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=""
NEXT_PUBLIC_NMI_ENVIRONMENT="sandbox"

# Webhooks are registered in the NMI portal against:
#   <NEXT_PUBLIC_APP_URL>/api/v1/webhooks/nmi
# NMI signs "<timestamp>.<raw body>" with the signing key above and sends it in the
# `webhook-signature` header, so (unlike Square) no notification-URL variable is needed.

# Optional: minutes before an unpaid order with no gateway payment id is marked abandoned (default 60).
# Orders still holding a charge claim are never swept — see chargeClaimedAt in the schema.
# ORDER_ABANDON_AFTER_MINUTES="60"

# ── Epson Server Direct Print (required from Sprint 5) ───────────────────────

# Serial number(s) of in-store Epson TM-m30III printers. Comma-separated if kitchen
# and counter are different devices. The identifying name on the printer's Server
# Direct Print page must match one of these values exactly.
PRINTER_SERIAL_NUMBER=""

# Shared secret. On the printer, set this as the Server Direct Print password
# (Digest auth). Tests may also pass it as ?key= or X-Print-Secret.
PRINTER_SDP_SHARED_SECRET=""

# Optional: override which serial receives kitchen tickets / counter receipts.
# Defaults to the first serial in PRINTER_SERIAL_NUMBER.
# PRINTER_KITCHEN_SERIAL=""
# PRINTER_COUNTER_SERIAL=""

# Optional sweeper knobs (milliseconds). Defaults: 90000 / 5 / 30000 / 120000.
# PRINT_SENT_TIMEOUT_MS="90000"
# PRINT_MAX_ATTEMPTS="5"
# PRINT_RETRY_BACKOFF_MS="30000"
# PRINT_UNACKNOWLEDGED_ORDER_MS="120000"

# ── Kitchen display (Sprint 6; all optional, defaults shown) ─────────────────

# Staff session lifetime. Default 12 hours — covers a shift without re-entry.
# KITCHEN_SESSION_TTL_MS="43200000"

# Consecutive failed PIN attempts before lockout, and lockout duration.
# KITCHEN_PIN_MAX_FAILURES="5"
# KITCHEN_PIN_LOCKOUT_MS="300000"

# Kitchen board poll interval (the PWA also receives this on each queue response).
# KITCHEN_POLL_INTERVAL_MS="3000"

# Unacknowledged order (still PAID/PRINTED): on-screen, audible, then manager job.
# KITCHEN_UNACK_SCREEN_MS="60000"
# KITCHEN_UNACK_SOUND_MS="120000"
# KITCHEN_UNACK_ALERT_MS="180000"

# ── Admin back-office (Sprint 8; all optional, defaults shown) ───────────────

# Admin session lifetime. Default 4 hours — shorter than the kitchen 12-hour shift
# because this session can refund money and change prices.
# ADMIN_SESSION_TTL_MS="14400000"

# Consecutive failed password attempts before lockout, and lockout duration.
# ADMIN_PASSWORD_MAX_FAILURES="5"
# ADMIN_PASSWORD_LOCKOUT_MS="900000"

# E.164 sending number (e.g. +17085551234).

# ── Transactional email (required in production from Sprint 11; optional in development) ─
# SPRINT-18: with SMS removed, this is the ONLY notification channel — customer receipts
# AND every manager alert. Unset in production means both go nowhere.

# Resend API key.
EMAIL_API_KEY=""

# From address on a verified domain (unverified domains land in spam or are rejected).
EMAIL_FROM_ADDRESS=""

# ── Background job worker (Sprint 7; all optional, defaults shown) ───────────

# Drain interval, claim bound, stranded RUNNING timeout, retry base backoff.
# JOB_WORKER_INTERVAL_MS="5000"
# JOB_WORKER_CLAIM_LIMIT="10"
# JOB_WORKER_STRANDED_MS="90000"
# JOB_WORKER_BACKOFF_MS="30000"

# Dead-job count that is logged and flagged on the queue report.
# JOB_DEAD_ALERT_THRESHOLD="5"

# Manager-alert volume cap: max delivered alerts per type per window.
# JOB_ALERT_MAX_PER_WINDOW="1"
# JOB_ALERT_WINDOW_MS="900000"

# ── Error tracking (Sprint 9; required in production runtime, optional in tests) ─

# Sentry DSN. Leave empty in local tests. Production should set this so errors
# reach a tracker that is not the application's own email path.
SENTRY_DSN=""

# Optional: directory for uploaded menu photographs (Sprint 12). Default: <repo>/data/uploads
# Must live outside the Next.js build output so deploys and restores keep images.
# IMAGE_UPLOAD_DIR=""

# Minimum log level: debug | info | warn | error. Production default is info
# so printer/kitchen polls (debug) do not fill the disk.
# LOG_LEVEL="info"

# Health check: worker last-pass older than this many ms is unhealthy (default 30000).
# WORKER_STALE_MS="30000"

# ── Scheduled reconciliation (Sprint 11; optional, defaults shown) ───────────

# Store-local hour (0–23) when the daily gateway/DB pass becomes due. Default 4.
# RECONCILE_HOUR_LOCAL="4"

# How often the process checks whether today's pass is due, in ms. Default 900000 (15 min).
# RECONCILE_CHECK_INTERVAL_MS="900000"

# Lookback window for the scheduled pass, in hours. Default 48.
# RECONCILE_LOOKBACK_HOURS="48"
